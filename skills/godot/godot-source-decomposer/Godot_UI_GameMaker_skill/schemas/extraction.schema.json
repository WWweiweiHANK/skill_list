{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Godot extraction record",
  "type": "object",
  "required": ["mode", "family", "scope", "dependencies", "risk", "interfaces"],
  "properties": {
    "mode": {"enum": ["Analyze", "Extract", "Build"]},
    "family": {"type": "string"},
    "scope": {"type": "object", "required": ["included", "excluded"], "properties": {"included": {"type": "array", "items": {"type": "string"}}, "excluded": {"type": "array", "items": {"type": "string"}}}},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["path", "role"], "properties": {"path": {"type": "string"}, "role": {"enum": ["required", "optional", "project-specific", "excluded-business-logic"]}}}},
    "risk": {"type": "object", "required": ["verdict"], "properties": {"verdict": {"enum": ["safe", "conditional", "blocked"]}, "mitigations": {"type": "array", "items": {"type": "string"}}}},
    "interfaces": {"type": "object", "properties": {"signals": {"type": "array", "items": {"type": "string"}}, "methods": {"type": "array", "items": {"type": "string"}}, "properties": {"type": "array", "items": {"type": "string"}}}}
  }
}
